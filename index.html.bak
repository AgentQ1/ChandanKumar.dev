<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Chandan Kumar - Full-Stack Engineer, AI/ML Developer & Cloud Infrastructure Specialist. Building scalable cloud applications and on-device AI systems.">
    <meta name="keywords" content="Full-Stack Engineer, AI/ML Developer, Cloud Infrastructure, Python, JavaScript, React, AWS, Edge Computing">
    <meta name="author" content="Chandan Kumar">
    <title>Chandan Kumar | Full-Stack Engineer & AI/ML Developer</title>
    <link rel="stylesheet" href="css/styles.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar" id="navbar">
        <div class="container">
            <div class="nav-brand">
                <a href="#home">CK</a>
            </div>
            <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Toggle menu">
                <span></span>
                <span></span>
                <span></span>
            </button>
            <ul class="nav-menu" id="navMenu">
                <li><a href="#home" class="nav-link">Home</a></li>
                <li><a href="#about" class="nav-link">About</a></li>
                <li><a href="#portfolio" class="nav-link">Portfolio</a></li>
                <li><a href="#resume" class="nav-link">Resume</a></li>
                <li><a href="#blog" class="nav-link">Blog</a></li>
                <li><a href="#contact" class="nav-link">Contact</a></li>
                <li>
                    <button class="theme-toggle" id="themeToggle" aria-label="Toggle theme">
                        <span class="sun-icon">☀️</span>
                        <span class="moon-icon">🌙</span>
                    </button>
                </li>
            </ul>
        </div>
    </nav>

    <!-- Hero Section -->
    <section id="home" class="hero">
        <div class="hero-background"></div>
        <div class="container">
            <div class="hero-content">
                <div class="hero-text">
                    <h1 class="hero-title">
                        Hi, I'm <span class="gradient-text">Chandan Kumar</span>
                    </h1>
                    <div class="typewriter-container">
                        <h2 class="typewriter" id="typewriter"></h2>
                    </div>
                    <p class="hero-description">
                        Innovative full-stack engineer specializing in AI/ML, distributed systems, and cloud infrastructure. 
                        I build scalable applications that solve real-world problems—from on-device LLM inference engines to 
                        privacy-first CRM platforms.
                    </p>
                    <div class="hero-cta">
                        <a href="#portfolio" class="btn btn-primary">View My Work</a>
                        <a href="#contact" class="btn btn-secondary">Get In Touch</a>
                    </div>
                    <div class="hero-social">
                        <a href="https://github.com/AgentQ1" target="_blank" rel="noopener" aria-label="GitHub">
                            <svg viewBox="0 0 24 24" width="24" height="24">
                                <path fill="currentColor" d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                            </svg>
                        </a>
                        <a href="https://www.linkedin.com/in/chandnnn/" target="_blank" rel="noopener" aria-label="LinkedIn">
                            <svg viewBox="0 0 24 24" width="24" height="24">
                                <path fill="currentColor" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                            </svg>
                        </a>
                        <a href="mailto:Ckumar5@hawk.iit.edu" aria-label="Email">
                            <svg viewBox="0 0 24 24" width="24" height="24">
                                <path fill="currentColor" d="M12 12.713l-11.985-9.713h23.97l-11.985 9.713zm0 2.574l-12-9.725v15.438h24v-15.438l-12 9.725z"/>
                            </svg>
                        </a>
                    </div>
                </div>
                <div class="hero-image">
                    <img src="images/profile.jpg" alt="Chandan Kumar - Professional Portrait" class="profile-image">
                </div>
            </div>
        </div>
        <div class="scroll-indicator">
            <span></span>
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="about">
        <div class="container">
            <h2 class="section-title">About Me</h2>
            <div class="about-content">
                <div class="about-text">
                    <p class="lead">
                        I'm a full-stack engineer with cross-domain experience across AI/ML, distributed systems, 
                        and cloud infrastructure. Currently pursuing my MBA in Business Analytics at Illinois Institute 
                        of Technology while building the future of AI-powered applications.
                    </p>
                    <p>
                        My journey started with a fascination for how technology can solve real-world problems. 
                        Today, I'm the founder of <strong>41Dayta</strong>, a privacy-first CRM platform that's grown to 
                        200+ beta sign-ups, and I've built projects ranging from on-device LLM inference engines 
                        to multilingual AI chat platforms.
                    </p>
                    <p>
                        I'm proficient in <strong>eight-plus programming languages</strong> including Python, JavaScript, 
                        Swift, Rust, C++, Go, and SQL. I'm passionate about serverless architectures, edge computing, 
                        and modern iOS development. When I'm not coding, you'll find me exploring game theory, 
                        running marathons (🥇 Gold Medal winner!), or contributing to open-source projects.
                    </p>
                    
                    <div class="highlights">
                        <h3>Key Highlights</h3>
                        <ul>
                            <li>🚀 Founder & Product Lead at 41Dayta (200+ users)</li>
                            <li>🤖 Built hardware-agnostic LLM inference framework supporting Rust, C++, Go, and Python</li>
                            <li>☁️ Developed cloud-native applications on AWS, Azure, and GCP</li>
                            <li>🏆 Best Student Award, Birkbeck University London</li>
                            <li>🏃 Gold Medal in Marathon, Amity Education Group Championship</li>
                            <li>🎓 Alpha Sigma Phi (ΑΣΦ) Member, Illinois Institute of Technology</li>
                        </ul>
                    </div>

                    <div class="skills-overview">
                        <h3>Technical Expertise</h3>
                        <div class="skill-categories">
                            <div class="skill-category">
                                <h4>Languages</h4>
                                <div class="skill-tags">
                                    <span class="tag">Python</span>
                                    <span class="tag">JavaScript</span>
                                    <span class="tag">Swift</span>
                                    <span class="tag">Rust</span>
                                    <span class="tag">C++</span>
                                    <span class="tag">Go</span>
                                    <span class="tag">SQL</span>
                                </div>
                            </div>
                            <div class="skill-category">
                                <h4>AI/ML & Data</h4>
                                <div class="skill-tags">
                                    <span class="tag">TensorFlow</span>
                                    <span class="tag">PyTorch</span>
                                    <span class="tag">scikit-learn</span>
                                    <span class="tag">LLM Inference</span>
                                    <span class="tag">Neo4j</span>
                                </div>
                            </div>
                            <div class="skill-category">
                                <h4>Cloud & DevOps</h4>
                                <div class="skill-tags">
                                    <span class="tag">AWS</span>
                                    <span class="tag">Azure</span>
                                    <span class="tag">GCP</span>
                                    <span class="tag">Docker</span>
                                    <span class="tag">Kubernetes</span>
                                    <span class="tag">Terraform</span>
                                </div>
                            </div>
                            <div class="skill-category">
                                <h4>Web & Mobile</h4>
                                <div class="skill-tags">
                                    <span class="tag">React/Next.js</span>
                                    <span class="tag">Node.js</span>
                                    <span class="tag">UIKit/SwiftUI</span>
                                    <span class="tag">Cloudflare Workers</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Portfolio Section -->
    <section id="portfolio" class="portfolio">
        <div class="container">
            <h2 class="section-title">Featured Projects</h2>
            <p class="section-subtitle">A selection of my recent work spanning AI/ML, cloud infrastructure, and mobile development</p>
            
            <div class="portfolio-filters">
                <button class="filter-btn active" data-filter="all">All Projects</button>
                <button class="filter-btn" data-filter="ai-ml">AI/ML</button>
                <button class="filter-btn" data-filter="cloud">Cloud</button>
                <button class="filter-btn" data-filter="mobile">Mobile</button>
                <button class="filter-btn" data-filter="web">Web</button>
            </div>

            <div class="portfolio-grid" id="portfolioGrid">
                <!-- Projects will be dynamically inserted here -->
            </div>
        </div>
    </section>

    <!-- Resume Section -->
    <section id="resume" class="resume">
        <div class="container">
            <h2 class="section-title">Professional Journey</h2>
            <div class="resume-actions">
                <a href="assets/Chandan_Kumar_Resume.pdf" class="btn btn-primary" download>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>
                    </svg>
                    Download Resume
                </a>
            </div>

            <div class="timeline">
                <!-- Timeline items will be dynamically inserted here -->
            </div>
        </div>
    </section>

    <!-- Blog Section -->
    <section id="blog" class="blog">
        <div class="container">
            <h2 class="section-title">Blog & Insights</h2>
            <p class="section-subtitle">Thoughts on AI/ML, cloud architecture, and software engineering</p>
            
            <div class="blog-grid" id="blogGrid">
                <!-- Blog posts will be dynamically inserted here -->
            </div>

            <div class="blog-cta">
                <p>More articles coming soon! Subscribe to stay updated.</p>
                <form class="newsletter-form" id="newsletterForm">
                    <input type="email" placeholder="Enter your email" required>
                    <button type="submit" class="btn btn-primary">Subscribe</button>
                </form>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="contact">
        <div class="container">
            <h2 class="section-title">Let's Connect</h2>
            <p class="section-subtitle">Interested in working together? I'd love to hear from you.</p>
            
            <div class="contact-content">
                <div class="contact-info">
                    <div class="contact-method">
                        <div class="icon">📧</div>
                        <h3>Email</h3>
                        <a href="mailto:Ckumar5@hawk.iit.edu">Ckumar5@hawk.iit.edu</a>
                    </div>
                    <div class="contact-method">
                        <div class="icon">📱</div>
                        <h3>Phone</h3>
                        <a href="tel:+13122964209">312-296-4209</a>
                    </div>
                    <div class="contact-method">
                        <div class="icon">📍</div>
                        <h3>Location</h3>
                        <p>Chicago, IL</p>
                    </div>
                    <div class="contact-method">
                        <div class="icon">🔗</div>
                        <h3>Social</h3>
                        <div class="social-links">
                            <a href="https://github.com/AgentQ1" target="_blank">GitHub</a>
                            <a href="https://www.linkedin.com/in/chandnnn/" target="_blank">LinkedIn</a>
                        </div>
                    </div>
                </div>

                <form class="contact-form" id="contactForm">
                    <div class="form-group">
                        <label for="name">Name *</label>
                        <input type="text" id="name" name="name" required>
                    </div>
                    <div class="form-group">
                        <label for="email">Email *</label>
                        <input type="email" id="email" name="email" required>
                    </div>
                    <div class="form-group">
                        <label for="projectType">Project Type</label>
                        <select id="projectType" name="projectType">
                            <option value="">Select a type...</option>
                            <option value="consulting">Consulting</option>
                            <option value="full-time">Full-time Position</option>
                            <option value="contract">Contract Work</option>
                            <option value="collaboration">Collaboration</option>
                            <option value="other">Other</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="message">Message *</label>
                        <textarea id="message" name="message" rows="5" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">Send Message</button>
                    <p class="form-notice">I typically respond within 24-48 hours.</p>
                </form>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-info">
                    <h3>Chandan Kumar</h3>
                    <p>Full-Stack Engineer | AI/ML Developer | Cloud Infrastructure Specialist</p>
                </div>
                <div class="footer-links">
                    <a href="#home">Home</a>
                    <a href="#about">About</a>
                    <a href="#portfolio">Portfolio</a>
                    <a href="#resume">Resume</a>
                    <a href="#blog">Blog</a>
                    <a href="#contact">Contact</a>
                </div>
                <div class="footer-social">
                    <a href="https://github.com/AgentQ1" target="_blank" aria-label="GitHub">GitHub</a>
                    <a href="https://www.linkedin.com/in/chandnnn/" target="_blank" aria-label="LinkedIn">LinkedIn</a>
                    <a href="mailto:Ckumar5@hawk.iit.edu" aria-label="Email">Email</a>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 Chandan Kumar. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="js/data.js"></script>
    <script src="js/main.js"></script>
</body>
</html>
